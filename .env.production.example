# Template for the SERVER .env. Copy to APP/.env on the server and fill in.
# Do NOT commit real passwords.
APP_NAME="IT Ticketing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cPanel > MySQL Databases: create DB + user, add user to DB with ALL PRIVILEGES.
# cPanel prefixes names with your username, e.g. cpuser_ticketing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_ticketing
DB_USERNAME=cpuser_ticketing
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
