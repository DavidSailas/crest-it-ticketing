+    /**
+     * Is the EMAIL switch on for this kind of notification? What they chose, or the default.
+     * New-ticket emails default on for IT Support — unless the team has a shared inbox
+     * (config company.team_inbox) that already gets them, to avoid duplicates.
+     */
+    public function emailSwitchOn(string $type): bool
+    {
+        $preferences = $this->email_preferences ?? [];
+
+        if (array_key_exists($type, $preferences)) {
+            return (bool) $preferences[$type];
+        }
+
+        if ($type === 'new_tickets') {
+            return $this->isItSupport() && blank(config('company.team_inbox'));
+        }
+
+        return true;
+    }
